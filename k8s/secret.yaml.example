# Copie este arquivo para k8s/secret.yaml e preencha com valores reais.
# k8s/secret.yaml NUNCA deve ser commitado (está no .gitignore).
apiVersion: v1
kind: Secret
metadata:
  name: fiap-mecanica-secret
  namespace: fiap-mecanica
type: Opaque
stringData:
  DB_USERNAME: "CHANGE_ME"
  DB_PASSWORD: "CHANGE_ME"
  JWT_SECRET: "CHANGE_ME"
  SERVICE_JWT_SECRET: "CHANGE_ME"
  # Usuario "mecanica" no RabbitMQ do cluster; a senha e a mesma que o CD do fiap-estoque usa para cria-lo.
  RABBITMQ_USERNAME: "mecanica"
  RABBITMQ_PASSWORD: "CHANGE_ME"
  NEW_RELIC_LICENSE_KEY: "CHANGE_ME"
