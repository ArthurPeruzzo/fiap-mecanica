DB_ROOT_PASSWORD=root
DB_USERNAME=root
DB_PASSWORD=root
JWT_SECRET=troque-por-um-segredo-base64url-com-no-minimo-32-bytes-decodificados
# Token de servico (monolito -> estoque): deve ser o mesmo do fiap-estoque e DIFERENTE do JWT_SECRET.
SERVICE_JWT_SECRET=troque-por-outro-segredo-base64url-com-no-minimo-32-bytes-decodificados
NEW_RELIC_LICENSE_KEY=troque-pela-sua-license-key-da-new-relic
# RabbitMQ: admin do broker, usuario do fiap-mecanica (so publica) e usuario do fiap-estoque (dono da fila).
# Use valores alfanumericos (as senhas viram JSON no script de inicializacao).
RABBITMQ_ADMIN_USER=admin
RABBITMQ_ADMIN_PASSWORD=troque-por-uma-senha
RABBITMQ_VHOST=fiap
RABBITMQ_USERNAME=mecanica
RABBITMQ_PASSWORD=troque-por-uma-senha
RABBITMQ_ESTOQUE_USERNAME=estoque
RABBITMQ_ESTOQUE_PASSWORD=troque-por-uma-senha
